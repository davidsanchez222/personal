---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/terminal.css"
import "@/styles/terminal-app.css"
import "@/styles/now.css"

import MetaHead from "@/components/MetaHead.astro"
import MetaPage from "@/components/MetaPage.astro"
import { SITE } from "@/consts"
import { getTerminalData } from "@/lib/terminal/data"

const data = await getTerminalData(Astro.site)
const json = JSON.stringify(data).replace(/</g, "\\u003c")
const { user, host } = data.prompt
---

<html lang={SITE.locale} dir={SITE.dir}>
  <MetaHead>
    <MetaPage />
    <script is:inline>
      document.documentElement.classList.add("js")
    </script>
  </MetaHead>
  <body>
    <term-window>
      <term-titlebar>
        <t-dots aria-hidden="true"
          ><span></span><span></span><span></span></t-dots
        >
        <span id="term-title">{user}@{host}: ~</span>
        <a href="/blog" title="Prefer a normal website?">gui mode ↗</a>
      </term-titlebar>
      <div id="term-body">
        <t-fallback>
          <h1>{data.user.name}</h1>
          {data.whoami.map((line) => <p>{line.replaceAll("`", "")}</p>)}
          <h2>Posts</h2>
          <ul>
            {data.posts.map((post) => (
                <li><a href={post.url}>{post.title}</a> · {post.description}</li>
              ))}
          </ul>
          <h2>Elsewhere</h2>
          <ul>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/projects">Projects</a></li>
            {data.socials.map(({ label, href }) => (
                <li><a href={href}>{label}</a></li>
              ))}
          </ul>
        </t-fallback>
        <div id="term-output" role="log" aria-label="Terminal output"></div>
        <div id="term-prompt">
          <span id="term-ps1"></span><span id="term-before"></span
          ><span id="term-cursor"> </span><span id="term-after"></span>
          <input
            id="term-input"
            type="text"
            aria-label="Terminal input. Type help for a list of commands."
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
          >
        </div>
      </div>
    </term-window>
    <script type="application/json" id="term-data" set:html={json} />
    <script>
      import "@/scripts/terminal/main"
    </script>
  </body>
</html>
