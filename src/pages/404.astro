---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout crumbs={[{ label: "404", href: "/404" }]}>
  <MetaPage slot="head" title="404" />
  <prose-content>
    <h1>404</h1>
    <shell-error>
      <p>
        <span>dsh:</span>
        no such file or directory:
        <code id="missing-path">this page</code>
      </p>
      <p>
        Try <a href="/">cd ~</a> to get back to the terminal, or
        <a href="/blog">ls ~/blog</a>
        to browse posts.
      </p>
    </shell-error>
  </prose-content>
</Layout>

<style>
  shell-error {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--1);

    span {
      color: var(--t-red);
    }
  }
</style>

<script>
  const missing = document.getElementById("missing-path")
  if (missing) missing.textContent = `~${location.pathname}`
</script>
