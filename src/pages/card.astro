---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/shape.css"
import "@/styles/terminal.css"

import { getEntry } from "astro:content"
import ArrowRight from "@/assets/icons/arrow-right.svg"
import MetaHead from "@/components/MetaHead.astro"
import MetaPage from "@/components/MetaPage.astro"
import QRCode from "qrcode"
import { GOATCOUNTER, SITE, SOCIALS, TERMINAL } from "@/consts"

// The page my lockscreen QR code (and later an NFC card) links to: a
// phone-first contact card rather than the keyboard-driven terminal.
const author = await getEntry("authors", TERMINAL.author)
const tagline = TERMINAL.whoami[0].replaceAll("`", "")
const socials = SOCIALS.filter(({ href }) => !href.startsWith("/"))

// The back of the card (green button): a QR code to scan straight off the
// screen, generated at build time so it follows the site's domain.
const shareUrl = new URL("/card?src=qr", Astro.site ?? Astro.url).href
const qr = await QRCode.toString(shareUrl, {
  type: "svg",
  margin: 1,
  color: { dark: "#303446", light: "#eff1f5" },
})
---

<html lang={SITE.locale} dir={SITE.dir}>
  <MetaHead>
    <MetaPage
      title="card"
      description={`${SITE.title}'s contact card.`}
      noindex
    />
    {GOATCOUNTER && (
        <script
          is:inline
          data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )}
  </MetaHead>
  <body>
    <card-window>
      <card-titlebar>
        <t-dots>
          <button
            type="button"
            data-win="close"
            aria-label="Close card"
          ></button>
          <button
            type="button"
            data-win="minimize"
            aria-label="Minimize card"
            aria-expanded="true"
          ></button>
          <button
            type="button"
            data-win="zoom"
            aria-label="Show QR code"
            aria-pressed="false"
          ></button>
        </t-dots>
        <span
          >{TERMINAL.user}@{TERMINAL.host}: ~/card<span data-qr-path
            >/qr</span
          ></span
        >
      </card-titlebar>

      <card-faces>
        <card-body data-face="front">
          <card-header>
            {author?.data.avatar && (
                <img
                  src={author.data.avatar}
                  alt=""
                  width="88"
                  height="88"
                  loading="eager"
                />
              )}
            <div>
              <p class="prompt" aria-hidden="true">$ whoami</p>
              <h1>{SITE.title}</h1>
              {author?.data.pronouns && (
                  <p class="muted">{author.data.pronouns}</p>
                )}
            </div>
          </card-header>

          <p class="tagline">{tagline}</p>

          <nav aria-label="Contact and links">
            <a href="/card/david.vcf" class="primary">
              <span class="label">Save contact</span>
              <span aria-hidden="true">+</span>
            </a>
            {socials.map(({ href, label, icon: Icon }) => (
                <a href={href} target="_blank" rel="noopener noreferrer">
                  <Icon aria-hidden="true" />
                  <span class="label">{label}</span>
                  <ArrowRight aria-hidden="true" />
                </a>
              ))}
            <a href="/blog">
              <span class="glyph" aria-hidden="true">~/</span>
              <span class="label">Blog</span>
              <ArrowRight aria-hidden="true" />
            </a>
            <a href="/">
              <span class="glyph" aria-hidden="true">&gt;_</span>
              <span class="label">Open the terminal</span>
              <ArrowRight aria-hidden="true" />
            </a>
          </nav>
        </card-body>
        <card-body data-face="back" inert>
          <p class="prompt" aria-hidden="true">$ qrencode ~/card</p>
          <div class="qr" role="img" aria-label={`QR code for ${shareUrl}`}>
            <Fragment set:html={qr} />
          </div>
          <p class="tagline">Scan to open this card on your phone.</p>
          <nav aria-label="Share">
            <button type="button" class="primary" data-share={shareUrl}>
              <span class="label">Share card</span>
              <span aria-hidden="true">↗</span>
            </button>
            <button type="button" data-win="zoom">
              <span class="glyph" aria-hidden="true">↺</span>
              <span class="label">Flip back</span>
            </button>
          </nav>
        </card-body>
      </card-faces>
    </card-window>

    <card-ended hidden>
      <p><span class="prompt">$</span> exit</p>
      <p>logout</p>
      <p class="muted">[Process completed]</p>
      <nav aria-label="Session ended">
        <button type="button" class="primary" data-reopen>
          <span class="label">Reopen card</span>
          <span aria-hidden="true">↺</span>
        </button>
        <a href="/">
          <span class="glyph" aria-hidden="true">→</span>
          <span class="label"
            >Visit {new URL(Astro.site ?? Astro.url).host}</span
          >
        </a>
      </nav>
    </card-ended>
  </body>
</html>

<style>
  body {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: 1rem;
    font-family: var(--font-mono);
    background-color: var(--t-crust);
    background-image: radial-gradient(
      color-mix(in oklab, var(--foreground) 10%, transparent) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
  }

  card-window,
  card-ended {
    display: block;
    inline-size: 100%;
    max-inline-size: 28rem;
    overflow: hidden;
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.45);
  }

  card-titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    font-size: 0.78rem;
    color: var(--muted-foreground);
    background-color: var(--t-mantle);
    border-block-end: 1px solid var(--border);
    user-select: none;

    [data-qr-path] {
      display: none;
    }
  }

  card-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem 1.25rem;
  }

  /* Both faces share one grid cell; zoom flips between them. */
  card-faces {
    display: grid;
    transition: transform 0.45s cubic-bezier(0.3, 0.7, 0.3, 1);
    transform-style: preserve-3d;

    card-body {
      grid-area: 1 / 1;
      backface-visibility: hidden;
    }

    [data-face="back"] {
      justify-content: center;
      transform: rotateY(180deg);
    }
  }

  .qr {
    align-self: center;
    inline-size: min(100%, 15rem);
    padding: 0.5rem;
    background: #eff1f5;
    border: 2px solid var(--t-accent);
    border-radius: var(--radius-xl);

    :global(svg) {
      display: block;
      inline-size: 100%;
      block-size: auto;
    }
  }

  card-window[data-flipped] {
    card-faces {
      transform: rotateY(180deg);
    }

    [data-qr-path] {
      display: inline;
    }
  }

  card-window[data-minimized] {
    card-faces {
      display: none;
    }

    card-titlebar {
      border-block-end: 0;
      cursor: pointer;
    }
  }

  card-window[data-closing] {
    animation: t-window-close 0.18s ease-in forwards;
  }

  card-ended {
    padding: 1.5rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.6;

    &[hidden] {
      display: none;
    }

    nav {
      margin-block-start: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    card-faces {
      transition: none;
    }

    card-window[data-closing] {
      animation-duration: 0s;
    }
  }

  card-header {
    display: flex;
    align-items: center;
    gap: 1rem;

    img {
      flex: none;
      inline-size: 88px;
      block-size: 88px;
      border-radius: 50%;
      border: 2px solid var(--t-accent);
    }

    h1 {
      font-size: 1.35rem;
      line-height: 1.2;
    }
  }

  .prompt {
    font-size: 0.8rem;
    color: var(--t-green);
  }

  .muted {
    font-size: 0.85rem;
    color: var(--muted-foreground);
  }

  .tagline {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted-foreground);
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;

    a,
    button {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      inline-size: 100%;
      font: inherit;
      text-align: start;
      cursor: pointer;
      min-block-size: 3.25rem;
      padding-inline: 1rem;
      font-size: 0.95rem;
      color: var(--foreground);
      text-decoration: none;
      background-color: var(--muted);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      transition: border-color 0.15s;

      &:hover,
      &:active {
        border-color: var(--t-accent);
      }

      .label {
        flex: 1;
      }

      svg {
        flex: none;
        inline-size: 1.125rem;
        block-size: 1.125rem;
      }

      > svg:last-child {
        color: var(--muted-foreground);
      }
    }

    .glyph {
      inline-size: 1.125rem;
      font-size: 0.8rem;
      color: var(--t-accent);
    }

    .primary {
      font-weight: 500;
      color: var(--t-crust);
      background-color: var(--t-accent);
      border-color: var(--t-accent);

      .label + span {
        font-size: 1.25rem;
      }
    }
  }
</style>

<script>
  // Traffic lights: close ends the "session", minimize collapses the card to
  // its title bar and zoom flips it over to the QR code.
  const win = document.querySelector("card-window") as HTMLElement
  const ended = document.querySelector("card-ended") as HTMLElement
  const front = win.querySelector('[data-face="front"]') as HTMLElement
  const back = win.querySelector('[data-face="back"]') as HTMLElement
  const button = (action: string) =>
    win.querySelector(`t-dots [data-win="${action}"]`) as HTMLElement

  const setMinimized = (minimized: boolean) => {
    win.toggleAttribute("data-minimized", minimized)
    button("minimize").setAttribute("aria-expanded", String(!minimized))
  }

  const setFlipped = (flipped: boolean) => {
    win.toggleAttribute("data-flipped", flipped)
    front.inert = flipped
    back.inert = !flipped
    const zoom = button("zoom")
    zoom.setAttribute("aria-pressed", String(flipped))
    zoom.setAttribute("aria-label", flipped ? "Show card" : "Show QR code")
  }

  const close = () => {
    win.dataset.closing = ""
    win.addEventListener(
      "animationend",
      () => {
        win.hidden = true
        win.removeAttribute("data-closing")
        ended.hidden = false
        ended.querySelector<HTMLElement>("[data-reopen]")?.focus()
      },
      { once: true },
    )
  }

  win.addEventListener("click", (event) => {
    const target = event.target as HTMLElement
    const action = target.closest<HTMLElement>("[data-win]")?.dataset.win
    if (action === "close") close()
    else if (action === "minimize")
      setMinimized(!win.hasAttribute("data-minimized"))
    else if (action === "zoom") {
      setMinimized(false)
      setFlipped(!win.hasAttribute("data-flipped"))
    } else if (
      win.hasAttribute("data-minimized") &&
      target.closest("card-titlebar")
    )
      setMinimized(false)
  })

  ended.querySelector("[data-reopen]")?.addEventListener("click", () => {
    ended.hidden = true
    setMinimized(false)
    setFlipped(false)
    win.hidden = false
    button("close").focus()
  })

  // Share sheet where there is one, otherwise copy the link.
  const share = win.querySelector<HTMLElement>("[data-share]")
  share?.addEventListener("click", async () => {
    const url = share.dataset.share ?? location.href
    const label = share.querySelector(".label") as HTMLElement
    try {
      if (navigator.share) await navigator.share({ title: document.title, url })
      else {
        await navigator.clipboard.writeText(url)
        label.textContent = "Link copied"
        setTimeout(() => (label.textContent = "Share card"), 2000)
      }
    } catch {
      // Share sheet dismissed, or clipboard blocked.
    }
  })
</script>
