---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

type Props = {
  name: string
  preview: NonNullable<CollectionEntry<"projects">["data"]["preview"]>
}

const { name, preview } = Astro.props
const { cast, cols, rows, poster } = preview
---

<terminal-preview
  data-cast={cast}
  data-cols={cols}
  data-rows={rows}
  style={`--cols: ${cols}; --rows: ${rows}`}
>
  <button type="button" aria-label={`Play ${name} terminal recording`}>
    {poster && <Image src={poster} alt="" width={1200} />}
    <play-badge aria-hidden="true">▶ play</play-badge>
  </button>
</terminal-preview>

<script>
  import type { Options } from "asciinema-player"

  // The player only parses hex values, so resolve the site's terminal tokens
  // (which use light-dark() and per-theme overrides) to hex at creation time.
  const PALETTE = [
    "--muted",
    "--t-red",
    "--t-green",
    "--t-yellow",
    "--t-blue",
    "--t-magenta",
    "--t-cyan",
    "--foreground",
    "--muted-foreground",
  ]

  // Painting a pixel normalizes any CSS color syntax (rgb, oklab, color()).
  const pixel = Object.assign(document.createElement("canvas"), {
    width: 1,
    height: 1,
  }).getContext("2d", { willReadFrequently: true })

  function toHex(color: string) {
    if (!pixel) return "#000000"
    pixel.clearRect(0, 0, 1, 1)
    pixel.fillStyle = color
    pixel.fillRect(0, 0, 1, 1)
    const [r, g, b] = pixel.getImageData(0, 0, 1, 1).data
    return `#${[r, g, b].map((n) => n.toString(16).padStart(2, "0")).join("")}`
  }

  function applyTheme(host: HTMLElement) {
    const probe = document.createElement("span")
    host.append(probe)
    const resolve = (token: string) => {
      probe.style.color = `var(${token})`
      return toHex(getComputedStyle(probe).color)
    }
    const colors = PALETTE.map(resolve)
    host.style.setProperty("--term-color-background", resolve("--background"))
    host.style.setProperty("--term-color-foreground", resolve("--foreground"))
    for (let i = 0; i < 8; i++) {
      host.style.setProperty(`--term-color-${i}`, colors[i])
      host.style.setProperty(`--term-color-${i + 8}`, colors[i === 0 ? 8 : i])
    }
    probe.remove()
  }

  async function mount(host: HTMLElement, startAt = 0, autoPlay = true) {
    const [{ create }] = await Promise.all([
      import("asciinema-player"),
      import("asciinema-player/dist/bundle/asciinema-player.css"),
    ])
    const { cast = "", cols, rows } = host.dataset
    applyTheme(host)
    const target = document.createElement("div")
    host.replaceChildren(target)
    const options: Options = {
      cols: Number(cols),
      rows: Number(rows),
      autoPlay,
      startAt,
      fit: "width",
      idleTimeLimit: 1.5,
      theme: "site",
      terminalFontFamily:
        getComputedStyle(host).getPropertyValue("--font-mono"),
    }
    return create(cast, target, options)
  }

  for (const host of document.querySelectorAll<HTMLElement>(
    "terminal-preview",
  )) {
    const button = host.querySelector("button")
    button?.addEventListener(
      "click",
      async () => {
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
        let player = await mount(host, 0, !reduced)

        // Rebuild on theme switches so the recording follows the page colors.
        new MutationObserver(async () => {
          const time = player.getCurrentTime()
          player.dispose()
          player = await mount(host, time, false)
        }).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme", "data-term-theme"],
        })
      },
      { once: true },
    )
  }
</script>

<style>
  terminal-preview {
    display: block;
    margin-block: var(--space-m);
    overflow: hidden;
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    > button {
      position: relative;
      display: grid;
      place-items: center;
      inline-size: 100%;
      /* Monospace cells are roughly 0.6em wide by 1.2em tall. */
      aspect-ratio: calc(var(--cols) * 0.6) / calc(var(--rows) * 1.2);
      padding: 0;
      cursor: pointer;
      background-color: var(--muted);

      :global(img) {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }

      play-badge {
        position: relative;
        padding: var(--space-2xs) var(--space-s);
        color: var(--primary-foreground);
        background-color: var(--primary);
        border-radius: var(--radius-full);
      }

      &:hover play-badge,
      &:focus-visible play-badge {
        background-color: var(--t-accent);
      }
    }

    :global(.ap-wrapper) {
      display: block;
    }
  }
</style>
